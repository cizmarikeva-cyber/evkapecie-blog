---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import portretImg from '../assets/images/portret.jpeg';
import { PREDAJCA } from '../data/predajca.js';
---

<BaseLayout
  title="O mne — Evka pečie"
  description="Ahoj, som Eva, amatérska pekárka z Brna. Zdieľam tradičné slovenské a české recepty na pečenie."
  activeNav="about"
>

  <main>

    <!-- HERO — portrét + úvod -->
    <section class="container">
      <div class="about-hero">

        <div class="about-col-left">
          <div class="about-portrait-wrap">
            <Image
              src={portretImg}
              alt="Eva Čižmariková — Evka pečie"
              class="about-portrait"
              width={400}
              height={400}
            />
          </div>
        </div>

        <div class="about-col-right">
          <div class="about-title">
            <div class="eyebrow">O mne</div>
            <h1 style="margin-top:16px">
              Ahoj, som <em>Eva</em>
            </h1>
          </div>
          <div class="about-text">
            <p class="about-intro">
              Vyrastala som na Slovensku a u nás doma sa niečo pieklo skoro každý víkend. Môj vzťah k pečeniu teda začal už v detstve vďaka mamke a obom mojim babičkám. Bavilo ma sledovať ich pri pečení, pomáhať im a samozrejme ochutnávať. Aj od nich som sa naučila, že na použitých surovinách záleží: maslo je nenahraditeľné, šľahačka musí byť vysokopercentná a ovocie zo záhrady sa s tým z obchodu nedá porovnať. To sú moje základy, od ktorých sa neodkloním.
            </p>
            <p class="about-intro" style="margin-top:16px">
              Po presťahovaní do Česka ma pečenie chytilo ešte viac. Najviac pečiem tradičné slovenské a české koláče, bábovky, kysnuté koláče a na Vianoce samozrejme cukroví a vianočku. Rada to striedam aj s modernými vecami, takže u mňa nájdeš napríklad aj mrkvový koláč, brownies či svadobné dezerty.
            </p>
            <p class="about-intro" style="margin-top:16px">
              Pečenie ma chytilo natoľko, že som si tento rok urobila rekvalifikačný kurz a pečiem už aj na objednávku. Veľmi sa teším, keď niečo upečiem aj pre vás!
            </p>
          </div>
        </div>

      </div>
    </section>

    <!-- KONTAKT -->
    <section class="container contact-section" id="contact" style="padding-bottom:96px">
      <h2 style="margin-bottom:24px">
        Napíšte mi
      </h2>

      <p class="about-intro" style="margin:0;display:flex;align-items:center;gap:10px">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-10 6L2 7"/>
        </svg>
        <span>{PREDAJCA.email}</span>
      </p>

      <div class="about-social" style="margin-top:20px">
        <a href="https://www.instagram.com/evkapecie/" target="_blank" rel="noopener noreferrer">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="4"/>
            <circle cx="17.5" cy="6.5" r=".8" fill="currentColor"/>
          </svg>
          Instagram
        </a>
        <a href="https://www.facebook.com/profile.php?id=61577433120544" target="_blank" rel="noopener noreferrer">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/>
          </svg>
          Facebook
        </a>
      </div>
    </section>

  </main>

  <script>
    // Scroll to contact if hash
    if (window.location.hash === '#contact') {
      setTimeout(() => {
        const el = document.getElementById('contact');
        if (el) el.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }, 80);
    }
  </script>

</BaseLayout>

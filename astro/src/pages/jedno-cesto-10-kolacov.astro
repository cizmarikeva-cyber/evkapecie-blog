---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import rolkyImg from '../assets/images/ebook-plateny/skoricove-rolky.jpeg';
import rozkyImg from '../assets/images/ebook-plateny/kakaove-rozky.jpeg';
import pletenceImg from '../assets/images/ebook-plateny/orechove-pletence.jpeg';
import babovkaImg from '../assets/images/ebook-plateny/lotus-babovka.jpeg';
import pistaciaImg from '../assets/images/ebook-plateny/pistaciovy-pletenec.jpeg';
import slaneImg from '../assets/images/ebook-plateny/kolace-slane.jpeg';
import ovocnyImg from '../assets/images/ebook-plateny/ovocny-s-drobenkou.jpeg';
import satockyImg from '../assets/images/ebook-plateny/tvarohove-satocky.jpeg';
import chlebikImg from '../assets/images/ebook-plateny/trhaci-chlebik.jpeg';
import buchtyImg from '../assets/images/ebook-plateny/slane-honzovy-buchty.jpeg';
import obalkaImg from '../assets/images/ebook-plateny/obalka-landing.jpg';
import portretImg from '../assets/images/portret2.jpeg';
import { PREDAJCA } from '../data/predajca.js';

// Tlačidlá vedú na objednávkový formulár SimpleShopu vložený pod cenou.
// Comgate vyžaduje formulár priamo na webe, odkaz na SimpleShop neakceptuje.
const CHECKOUT_URL = '#objednavka';

// 10 koláčov z e-booku.
const kolace = [
  { name: 'Ovocný koláč na plech', img: ovocnyImg },
  { name: 'Škoricové rolky s jablkami a polevou', img: rolkyImg },
  { name: 'Kakaové rohlíčky', img: rozkyImg },
  { name: 'Orechové pletence s Nutellou', img: pletenceImg },
  { name: 'Kysnutá Lotus bábovka', img: babovkaImg },
  { name: 'Tvarohové šatôčky s lekvárom a makovou posýpkou', img: satockyImg },
  { name: 'Pistáciový pletenec s bielou čokoládou', img: pistaciaImg },
  { name: 'Slané koláče s bryndzou a slaninou', img: slaneImg },
  { name: 'Syrovo-cesnakový trhací chlebík', img: chlebikImg },
  { name: 'Buchty s mäsovou náplňou', img: buchtyImg },
];

// Recenzie v znení schválenom Evou (zdroj: knowledge/raw/projekty/2026-09-27-spatna-vazba-screenshoty.md).
const recenzie = [
  { meno: 'Iveta', text: 'Moc děkuji za recept. Dnes jsem zkusila a jsem nadšená. Konečně recept na měkkoučké těsto. Jako peřinka.' },
  { meno: 'Mária', text: 'Išla som presne podľa tvojich inštrukcií a dopadlo to nad moje očakávania. Nie som veľkým fanúšikom kysnutého cesta ale vždy som chcela takúto dobrotu upiecť. Ďakujem za tvoju tvorbu.' },
  { meno: 'Natal', text: 'Dnes som upiekla a musím povedať, že lepšie škoricové hniezda som v živote nepripravila. Fantastické!!! Ďakujem za tento recept ❤️' },
  { meno: 'Andrea', text: 'Ďakujem za recept ❤️ práve som dopiekla a vyrazilo mi dekel 😄❤️❤️' },
];
---

<BaseLayout
  activeNav="ebooks"
  noindex
  title="Jedno cesto, 10 koláčov | Evka pečie"
  description="Systém, ako z jedného kysnutého cesta vytvárať vlastné sladké aj slané koláče. 10 otestovaných receptov, harmonogram pečenia na dva dni a tipy na čerstvosť."
>

  <main class="pe-main">

    <!-- HERO -->
    <section class="container pe-hero">
      <div class="pe-hero-text">
        <div class="eyebrow">E-book</div>
        <h1 class="pe-title">Jedno cesto, <em>10 koláčov</em></h1>
        <p class="pe-lead">
          Alebo systém, ako z jedného cesta vytvárať vlastné sladké aj slané recepty.
        </p>
        <p class="pe-lead pe-lead-more">
          Podobne ako v mojom e-booku <a href="/ebook-zdarma"><em>Jedno cesto, tri koláče</em></a> využívam ako základ <strong>kysnuté cesto</strong>. Tu ťa však naučím celý môj systém, ako z neho vytvoriť <strong>nespočetné množstvo</strong> ďalších koláčov, či už slaných alebo sladkých. Naučíš sa, ako kombinovať chute, ktorá náplň sa hodí ku ktorému tvaru, a potom už nebudeš musieť recepty stále hľadať, ale <strong>začneš si ich skladať.</strong>
        </p>
        <p class="pe-lead pe-lead-more">
          Navyše je v ebooku <strong>10 ukážkových receptov</strong>. Nájdeš v ňom aj rôzne tipy, napríklad ako si časovo zorganizovať pečenie, ako zachovať čerstvosť koláčov alebo ako im dodať nový život na druhý deň.
        </p>
        <div class="pe-cta">
          <a class="btn btn-primary btn-large" href={CHECKOUT_URL}>Chcem ebook za 249 Kč</a>
          <p class="pe-price-note">Prvých 7 dní za 249 Kč, potom 299 Kč.</p>
        </div>
      </div>

      <div class="pe-hero-media">
        <Image src={obalkaImg} alt="Jedno cesto, 10 koláčov: koláče z e-booku" class="pe-hero-cover" widths={[560, 1190]} sizes="(max-width: 768px) 100vw, 560px" />
      </div>
    </section>

    <!-- MOŽNO TO POZNÁŠ -->
    <section class="container pe-section pe-narrow">
      <h2 class="pe-h2">Je ti toto povedomé?</h2>
      <p class="pe-text">
        Chceš upiecť niečo dobré. Otvoríš Instagram, potom Google, potom uložené recepty, a zrazu máš 17 receptov, každý je trochu iný. A ešte k tomu musíš ísť do obchodu, lebo si zistila, že ti chýba jedna ingrediencia.
      </p>
      <p class="pe-text">
        Preto som nechcela, aby bol tento ebook len ďalší zoznam receptov. Chcem, aby si si po prečítaní povedal/a:
      </p>
      <p class="pe-signoff">Mám doma tieto suroviny. Viem, akú náplň z nich urobím a do akého tvaru ju dám. A poznám recept na overené cesto.</p>
    </section>

    <!-- 10 KOLÁČOV -->
    <section class="container pe-section">
      <h2 class="pe-h2">Z tohto jedného cesta upečieš:</h2>
      <ol class="pe-grid">
        {kolace.map((k, i) => (
          <li class="pe-card">
            <div class={`pe-card-media ${k.paint ?? ''}`}>
              {k.img && (
                <Image src={k.img} alt={k.name} class="pe-card-img" widths={[320, 520]} sizes="(max-width: 768px) 50vw, 220px" />
              )}
              <span class="pe-card-num">{String(i + 1).padStart(2, '0')}</span>
            </div>
            <p class="pe-card-name">{k.name}</p>
          </li>
        ))}
      </ol>
      <p class="pe-hand">Každý z nich som sama upiekla a otestovala.</p>
    </section>

    <!-- KTO SOM + RECENZIE -->
    <section class="container pe-section">
      <div class="pe-about">
        <Image src={portretImg} alt="Eva, autorka blogu Evka pečie" class="pe-about-img" width={600} />
        <div>
          <h2 class="pe-h2">Ahoj! Som Evka,</h2>
          <p class="pe-text">
            veľa pečiem a jednou z mojich obľúbených tém sú tradičné koláče z kysnutého cesta. Mám pocit, že sa z dnešných domácností trochu vytrácajú. Aj touto knihou chcem ukázať, že ich príprava nemusí byť zložitá, ak sa dodrží pár základných princípov.
          </p>
          <p class="pe-text">
            Klasiky z kysnutého cesta milujem, ale nájdete u mňa aj jeho twisty na moderný spôsob (pár z nich je aj v tomto ebooku), a napríklad aj moderné dezerty vhodné na sweetbar. O nich bude možno ďalšia kniha 👀
          </p>
          <p class="pe-text">
            Na <a href="https://www.instagram.com/evkapecie/" target="_blank" rel="noopener noreferrer">Instagrame</a> a <a href="https://www.facebook.com/profile.php?id=61577433120544" target="_blank" rel="noopener noreferrer">Facebooku</a> ma dohromady sleduje, a podľa mojich receptov pečie, viac ako 40 000 ľudí. Toto sú slová ľudí, ktorí už piekli z tohto cesta podľa verejne dostupných receptov:
          </p>
        </div>
      </div>
      <div class="pe-quotes">
        {recenzie.map((r) => (
          <blockquote class="pe-quote"><p>„{r.text}"</p><cite class="pe-quote-name">{r.meno}</cite></blockquote>
        ))}
      </div>
      <p class="pe-signoff">Tak čo, ideš piecť so mnou?</p>
    </section>

    <!-- ČO DOSTANEŠ + CENA -->
    <section class="container pe-section" id="cena">
      <div class="newsletter pe-offer">
        <div class="pe-offer-inner">
          <div>
            <h2>Čo teda za 249 Kč dostaneš?</h2>
            <ul class="pe-checks">
              <li><strong>10 otestovaných receptov:</strong> od sladkých roliek a bábovky až po slané buchty a trhací chlebík.</li>
              <li><strong>Jedno cesto na sladké aj slané:</strong> nemusíš sa učiť dva rôzne základy.</li>
              <li><strong>Harmonogram pečenia na dva dni:</strong> konkrétny časový harmonogram - čo pripraviť večer, aby si ráno mohla už len piecť.</li>
              <li><strong>Zoznam náplní, posýpok a poliev,</strong> ktoré môžeš s týmto cestom kombinovať.</li>
              <li><strong>Návod na vlastný koláč:</strong> aby tých 10 receptov nebolo konečné číslo.</li>
              <li><strong>Kapitolu „čo s koláčom na druhý deň":</strong> ako zachovať čerstvosť, alebo ako dodať koláčom druhý život.</li>
              <li><strong>PDF hneď po zaplatení:</strong> stiahneš si ho a môžeš rovno piecť.</li>
            </ul>
          </div>
          <div class="pe-price-card">
            <p class="pe-price-label">Prvých 7 dní za 249 Kč</p>
            <p class="pe-price"><span class="pe-price-now">249 Kč</span> <s class="pe-price-old">299 Kč</s></p>
            <p class="pe-price-text">
              Ebook práve vychádza a prvý týždeň bude za uvádzaciu cenu 249 Kč, potom bude stáť 299 Kč. Je to jednorazová platba a odkaz na stiahnutie ti príde do e-mailu hneď po zaplatení. Potom je navždy tvoj.
            </p>
            <a class="btn btn-large pe-btn-light" href={CHECKOUT_URL}>Chcem ebook za 249 Kč</a>
          </div>
        </div>
      </div>
    </section>

    <!-- FORMULÁR -->
    <section class="container pe-section">
      <!-- Objednávkový formulár SimpleShop (produkt za 249 Kč). Kód sa nemení, inak môže prestať fungovať. -->
      <div class="pe-form" id="objednavka">
        <!-- www.SimpleShop.cz form#159215 start -->
        <div data-SimpleShopForm="BRwl0"><div>Prodejní formulář je vytvořen v systému <a href="https://www.simpleshop.cz/?utm_source=simpleshop&utm_medium=form&utm_campaign=106156" target="_blank">SimpleShop.cz</a>.</div></div>
        <script is:inline>
         (function(i, s, o, g, r, a, m){
          i[r] = i[r] || function(){
           (i[r].q = i[r].q || []).push(arguments)
          }, i[r].l = 1 * new Date();
          a = s.createElement(o),
          m = s.getElementsByTagName(o)[0];
          a.async = 1;
          a.src = g;
          m.parentNode.insertBefore(a, m)
         })(window, document, "script", "https://form.simpleshop.cz/prj/js/SimpleShopService.js", "sss");
         sss("createForm", "BRwl0");
        </script>
        <!-- www.SimpleShop.cz form#159215 end -->
      </div>
    </section>

    <!-- FAQ -->
    <section class="container pe-section pe-narrow">
      <h2 class="pe-h2">Časté otázky</h2>
      <div class="pe-faq">
        <details>
          <summary>Pre koho je tento ebook?</summary>
          <ul class="pe-arrows">
            <li>nechceš pri každom pečení začínať od nového receptu</li>
            <li>chceš si vedieť vytvoriť vlastný koláč podľa toho, čo máš zrovna doma</li>
            <li>chceš poznať univerzálne cesto, z ktorého sa dá upiecť sladké aj slané</li>
            <li>piekla si podľa ebooku „Jedno cesto, tri koláče" a chceš z jedného cesta viac než len tri koláče</li>
            <li>chceš vedieť, ako si pečenie rozdeliť na dva dni</li>
          </ul>
          <p>Nie je pre teba, ak hľadáš torty, dezerty alebo zdobenie. Táto kniha je o kysnutom ceste, o tom, ako ho raz pochopiť a potom ho používať stále znova.</p>
        </details>
        <details>
          <summary>Je to rovnaké cesto ako v ebooku Jedno cesto, 3 koláče?</summary>
          <p>V princípe áno, a je to zámer. Jediné, čo sa mení, je množstvo soli. Tentoraz sa naučíš, čo všetko sa z neho dá pripraviť a ako kombinovať jednotlivé náplne a tvary. Kniha obsahuje aj „ťahák" receptov na náplne, posýpky a polevy, s množstvami presne na dané množstvo cesta.</p>
        </details>
        <details>
          <summary>Nikdy som kysnuté nepiekla. Zvládnem to?</summary>
          <p>Ak si nie si istá, môžeš začať mojím ebookom <a href="/ebook-zdarma"><em>Jedno cesto, tri koláče</em></a>, kde si skúsiš a naučíš sa samotný základ. Tento ebook je jeho pokračovanie.</p>
        </details>
        <details>
          <summary>Ako ebook dostanem?</summary>
          <p>Ako PDF, do e-mailu ti príde odkaz na stiahnutie hneď po zaplatení.</p>
        </details>
        <details>
          <summary>Čo mám robiť, ak mi ebook nepríde?</summary>
          <p>Skontroluj, prosím, aj priečinok so spamom a reklamami, niekedy e-mail spadne tam. Ak ani tam nie je, napíš mi na <a href={`mailto:${PREDAJCA.email}`}>{PREDAJCA.email}</a>. Ozvem sa ti do 24 hodín a vyriešime to.</p>
        </details>
        <details>
          <summary>Môžem platiť v eurách?</summary>
          <p>Áno - kartou, Apple Pay alebo Google Pay. Cena je v českých korunách a banka ju automaticky prepočíta na eurá. 249 Kč je približne 10,20 €. Výsledná suma závisí od kurzu tvojej banky.</p>
        </details>
      </div>
    </section>

  </main>

</BaseLayout>

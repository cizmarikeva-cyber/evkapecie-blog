---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image, getImage } from 'astro:assets';
import heroImg from '../assets/images/cukrovi/velka-detail1.jpeg';
import velkaImg from '../assets/images/cukrovi/velka-krabica.jpeg';
import malaDarekImg from '../assets/images/cukrovi/mala-krabica-darek.jpeg';
import malaObsahImg from '../assets/images/cukrovi/mala-krabica-obsah.jpeg';
import galTartaletka from '../assets/images/cukrovi/detail-tartaletka.jpeg';
import galRafaello from '../assets/images/cukrovi/detail-rafaello.jpeg';
import galMedovnikove from '../assets/images/cukrovi/detail-medovnikove.jpeg';
import galVosiHnizda from '../assets/images/cukrovi/detail-vosi-hnizda.jpeg';
import galMilionarsky from '../assets/images/cukrovi/detail-milionarsky.jpeg';
import galMix from '../assets/images/cukrovi/detail-mix.jpeg';

const GALERIE = [
  { src: galTartaletka,  alt: 'Tartaletky s malinami a bílou čokoládou' },
  { src: galVosiHnizda,  alt: 'Pistáciové vosí hnízda s malinovým krémem' },
  { src: galMilionarsky, alt: 'Milionářský řez' },
  { src: galRafaello,    alt: 'Rafaello' },
  { src: galMix,         alt: 'Linecké, tartaletky a vanilkové rohlíčky v krabičce' },
  { src: galMedovnikove, alt: 'Medovníkové kuličky' },
];
import {
  GOOGLE_FORM, MAX_KRABIC, PREVZETI, PLATBA, OBJEDNAVKY_DO, KAPACITA_SHEET,
  TERMINY_VYZDVIHNUTIE, TERMIN_ROZVOZ, OBSAZENO, ROZVOZ_POZNAMKA, KRABICE, DRUHY, ALERGENY, UPOZORNENI, VYZDVIHNUTIE,
} from '../data/cukrovi.js';

// Tlačidlá „Objednat“ vedú na formulár nižšie na stránke.
const ORDER_URL = '#objednavka';
const orderAttrs = {};

const [velka, mala] = KRABICE;

// Ručný prepínač „obsazeno“. Voľné krabičky zo sheetu dopĺňa skript v prehliadači.
const jeObsazeno = (id) => !!OBSAZENO[id];

// Termíny vo formulári rozdelené na osobný odber a rozvoz (dve úrovne: spôsob → dátum).
const SKUPINY_TERMINOV = [
  { id: 'osobne', nazov: 'Osobní vyzvednutí', pod: VYZDVIHNUTIE.adresa, terminy: PREVZETI.filter(p => !p.rozvoz) },
  { id: 'rozvoz', nazov: 'Rozvoz po Brně', cena: VYZDVIHNUTIE.rozvozCena, pod: ROZVOZ_POZNAMKA, terminy: PREVZETI.filter(p => p.rozvoz) },
];
// Údaje pre skript formulára (ceny, ID polí Google Formulára).
const formConfig = {
  maxKrabic: MAX_KRABIC,
  zprava: PLATBA.zprava,
  action: GOOGLE_FORM.action,
  entry: GOOGLE_FORM.entry,
  cenaVelka: velka.cena,
  cenaMala: mala.cena,
  cenaRozvoz: VYZDVIHNUTIE.rozvozCena,
  prevzeti: PREVZETI,
  rozvozId: TERMIN_ROZVOZ.id,
  kapacitaSheet: KAPACITA_SHEET,
};

// Fotky ku krabičkám (orezané do štvorca cez CSS).
// lenMobil: fotka sa ukáže len na mobile (malá krabička: zabalená + otvorená vedľa seba, Eva 26. 11. 2026).
const FOTKY = {
  velka: [{ src: velkaImg, alt: 'Velká krabička cukroví shora, 8 druhů' }],
  mala: [
    { src: malaDarekImg, alt: 'Malá krabička v dárkovém balení s mašlí' },
    { src: malaObsahImg, alt: 'Otevřená malá krabička s cukrovím', lenMobil: true },
  ],
};

// Text o surovinách: na PC v úvode, na mobile pod zoznamom druhov (jeden zdroj, dve miesta).
const SUROVINY_TEXT = 'Peču z másla, kvalitní čokolády a z ořechů a džemů od lokálních dodavatelů. Nepoužívám žádné náhražky ani levné suroviny, aby cukroví chutnalo tak, jak má.';

const kc = (n) => n.toLocaleString('cs-CZ').replace(/\s/g, ' ') + ' Kč';

// Náhľad pri zdieľaní odkazu (Facebook, WhatsApp, Messenger): 1200x630, detail cukroví (hero fotka).
const ogObrazok = await getImage({ src: heroImg, width: 1200, height: 630, fit: 'cover', format: 'jpeg' });
---

<BaseLayout
  activeNav="cukrovi"
  title="Vánoční cukroví na objednávku | Evka pečie"
  image={ogObrazok.src}
  description="Vánoční krabička cukroví z Brna: 8 druhů, velká krabička 1 kg nebo malá 16 ks. Vyzvednutí na Údolní 34 nebo rozvoz po Brně."
>

  <main class="ck-page">

    <!-- HERO (na mobile z neho ostáva len nadpis h1, potom hneď krabičky) -->
    <section class="container ck-hero">
      <div>
        <div class="eyebrow ck-len-pc">Vánoční nabídka</div>
        <h1 class="ck-title">Vánoční cukroví <em>z poctivých surovin</em></h1>
        <p class="ck-lead ck-len-pc">
          Letos jsem pro vás připravila krabičku vánočního cukroví s 8 druhy, které mám nejraději. Najdete v ní klasiku jako linecké a vanilkové rohlíčky podle naší rodinné receptury, ale i něco modernějšího, třeba malinové tartaletky s bílou čokoládou, takže si u stolu vybere opravdu každý.
        </p>
        <p class="ck-lead ck-len-pc">{SUROVINY_TEXT}</p>
        <p class="ck-lead ck-len-pc">
          Moc se těším, až ho upeču i pro vás!
        </p>
        <div class="ck-cta ck-len-pc">
          <a class="btn btn-primary btn-large" href={ORDER_URL} {...orderAttrs}>Objednat cukroví</a>
          <a class="btn btn-secondary btn-large" href="#krabicky">Prohlédnout krabičky</a>
        </div>
      </div>
      <div class="ck-foto ck-hero-foto">
        <Image src={heroImg} alt="Vánoční cukroví ve velké krabičce" width={900} loading="eager" fetchpriority="high" />
      </div>
    </section>

    <!-- GALÉRIA (na mobile až pod „V krabičce“) -->
    <section class="container ck-section ck-sec-galerie">
      <div class="ck-galerie">
        {GALERIE.map(g => (
          <Image src={g.src} alt={g.alt} width={700} class="ck-galerie-img" loading="lazy" />
        ))}
      </div>
    </section>

    <!-- KRABIČKY -->
    <section class="container ck-section ck-sec-krabicky" id="krabicky">
      <div class="eyebrow"><span class="ck-len-pc">Vánoční krabičky</span><span class="ck-len-mobil">Vyberte si velikost</span></div>
      <h2 class="ck-h2 ck-len-pc">Vyberte si <em>velikost</em></h2>
      <div class="ck-boxes">
        {KRABICE.map(k => (
          <div class={`ck-box ck-box-${k.id}`}>
            <div class="ck-box-media">
              <div class="ck-box-fotky">
                {FOTKY[k.id].map(f => (
                  <Image src={f.src} alt={f.alt} width={700} class={f.lenMobil ? 'ck-box-foto ck-box-foto-mobil' : 'ck-box-foto'} />
                ))}
              </div>
              <!-- Štítok na fotke, keď je krabička vypredaná (zapína skript zo sheetu, Eva 28. 11. 2026) -->
              <span class="ck-box-stitok" hidden>Vyprodáno</span>
              <!-- „Fotografie má ilustrační charakter…“ skryté v info ikone na fotke (Eva, 27. 11. 2026) -->
              {k.pozn && (
                <div class="ck-info">
                  <button type="button" class="ck-info-btn" aria-label="Informace k fotografii" aria-expanded="false" aria-describedby={`ck-info-${k.id}`}>i</button>
                  <span class="ck-info-tip" id={`ck-info-${k.id}`} role="tooltip">{k.pozn}</span>
                </div>
              )}
            </div>
            <div class="ck-box-text">
              <h3 class="ck-box-name">{k.nazov}</h3>
              <div class="ck-box-price">{kc(k.cena)}</div>
              {k.obsah.map(o => <p class="ck-box-obsah" set:html={o} />)}
              <a class="btn btn-primary" href={ORDER_URL} data-predvolit={k.id === 'velka' ? 'velke' : 'male'} {...orderAttrs}>Objednat</a>
              <!-- Uzávierka pod tlačidlom ako poznámka pod čiarou, bez roku a bez medzier v dátume (6.12.), aby sa zmestila na 1 riadok (Eva, 27. 11. 2026) -->
              <p class="ck-box-do">Objednávky přijímám do <strong>{OBJEDNAVKY_DO.replace(/\s*\d{4}$/, '').replace(/\s/g, '')}</strong> nebo do vyprodání.</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- DRUHY A ALERGENY -->
    <section class="container ck-section ck-sec-druhy">
      <div class="eyebrow">V krabičce</div>
      <h2 class="ck-h2"><em>8 druhů</em> cukroví</h2>
      <ul class="ck-list">
        {DRUHY.map(d => <li>{d}</li>)}
      </ul>
      <!-- Text o surovinách z úvodu: na mobile tu, na PC ostáva v hero. -->
      <p class="ck-lead ck-suroviny-mobil">{SUROVINY_TEXT}</p>
      <div class="ck-alergeny">
        {ALERGENY.map(a => <p>{a}</p>)}
      </div>
    </section>

    <!-- VYZVEDNUTÍ -->
    <section class="container ck-section ck-sec-ostatne">
      <div class="eyebrow">Vyzvednutí</div>
      <h2 class="ck-h2">Osobně nebo <em>rozvoz v Brně</em></h2>
      <div class="ck-duo">
        <div class="ck-panel">
          <h3>Osobní vyzvednutí</h3>
          <p>Na mé provozovně: {VYZDVIHNUTIE.adresa}.</p>
          <ul class="ck-terminy">{TERMINY_VYZDVIHNUTIE.map(t => <li data-termin-info={t.id} class={jeObsazeno(t.id) ? 'is-obsazeno' : undefined}>{t.text}<span class="ck-obsazeno-txt">{jeObsazeno(t.id) && ' (vyprodáno)'}</span></li>)}</ul>
        </div>
        <div class="ck-panel">
          <h3>Rozvoz v Brně</h3>
          <p>V rámci Brna vám cukroví můžeme přivézt na vaši adresu. Cena dopravy je <strong>{kc(VYZDVIHNUTIE.rozvozCena)}</strong>.</p>
          <ul class="ck-terminy"><li data-termin-info={TERMIN_ROZVOZ.id} class={jeObsazeno(TERMIN_ROZVOZ.id) ? 'is-obsazeno' : undefined}>{TERMIN_ROZVOZ.text}<span class="ck-obsazeno-txt">{jeObsazeno(TERMIN_ROZVOZ.id) && ' (vyprodáno)'}</span></li></ul>
          <p>{ROZVOZ_POZNAMKA}</p>
        </div>
      </div>
    </section>

    <!-- OBJEDNÁVKA -->
    <!-- OBJEDNÁVKA + JAK TO FUNGUJE: na PC vedľa seba, na mobile pod sebou (Eva, 27. 11. 2026) -->
    <section class="container ck-sec-ostatne ck-obj-layout" id="objednavka">
      <div class="ck-objednavka">
        <div class="eyebrow" style="color:var(--vermillion-tint)">Objednávka</div>

        <form class="ck-form" id="ck-form" novalidate>

          <!-- Objednávka v 2 krokoch (Eva, 27. 11. 2026) -->
          <div class="ck-postup" aria-live="polite">
            <div class="ck-postup-pruh"><span class="is-aktivny" data-postup="1"></span><span data-postup="2"></span></div>
            <p class="ck-postup-text">Krok <span id="ck-postup-cislo">1</span> ze 2: <strong id="ck-postup-nazov">Množství a termín</strong></p>
          </div>

          <!-- KROK 1: množstvo + termín -->
          <div class="ck-krok" data-krok="1">

            <fieldset class="ck-fieldset">
              <legend class="ck-legend">Vyberte množství</legend>
              <div class="ck-produkty">
                {[['velke', velka], ['male', mala]].map(([name, k]) => (
                  <div class="ck-produkt" data-produkt={name}>
                    <div class="ck-produkt-text">
                      <span class="ck-produkt-nazov" id={`ck-label-${name}`}>{k.nazov}</span>
                      <span class="ck-produkt-meta">{k.vaha} · {kc(k.cena)}</span>
                      <span class="ck-zbyva is-malo" data-vyprodano={name} hidden>Vyprodáno</span>
                    </div>
                    <div class="ck-stepper" role="group" aria-labelledby={`ck-label-${name}`}>
                      <button type="button" class="ck-step" data-step="-1" data-for={name} aria-label="Ubrat jednu krabičku">−</button>
                      <output class="ck-step-value" data-value-for={name} aria-live="polite">0</output>
                      <button type="button" class="ck-step" data-step="1" data-for={name} aria-label="Přidat jednu krabičku">+</button>
                      <input type="hidden" name={name} value="0" />
                    </div>
                  </div>
                ))}
              </div>
              <p class="ck-error" data-error="krabicky" hidden>Vyberte aspoň jednu krabičku.</p>
              <p class="ck-error" data-error="male" hidden></p>
            </fieldset>

            <fieldset class="ck-fieldset">
              <legend class="ck-legend">Vyberte termín</legend>
              <!-- Spôsob prevzatia ako riadky s krúžkom; termíny sú vnorené pod vybranou voľbou.
                   Osobný odber je predvolený. Jeden výber termínu (name="termin") cez obe voľby. (Eva, 27. 11. 2026) -->
              <div class="ck-volby">
                {SKUPINY_TERMINOV.map((s, i) => (
                  <div class="ck-volba">
                    <label class="ck-volba-riadok">
                      <input type="radio" name="zpusob" value={s.id} checked={i === 0} />
                      <span class="ck-volba-nazov">{s.nazov}</span>
                      {s.cena && <span class="ck-volba-cena">+{kc(s.cena)}</span>}
                    </label>
                    <div class="ck-skupina" data-skupina={s.id} hidden={i !== 0}>
                      <p class="ck-skupina-pod">{s.pod}</p>
                      <div class="ck-terminy-zoznam">
                        {s.terminy.map(t => (
                          <label class={jeObsazeno(t.id) ? 'ck-termin-karta is-obsazeno' : 'ck-termin-karta'} data-termin={t.id}>
                            <input type="radio" name="termin" value={t.id} disabled={jeObsazeno(t.id)} class="ck-vh" />
                            <span class="ck-termin-hlava">
                              <span class="ck-termin-den">{t.den}</span>
                              <span class="ck-termin-cas">{t.cas}</span>
                            </span>
                            <span class="ck-termin-stav">
                              <span class="ck-bar" aria-hidden="true" hidden><span></span></span>
                              <span class="ck-zbyva">{jeObsazeno(t.id) && 'Vyprodáno'}</span>
                            </span>
                          </label>
                        ))}
                      </div>
                      {s.id === 'rozvoz' && (
                        <label class="ck-field" id="ck-adresa" hidden>
                          <span class="ck-label">Adresa pro rozvoz</span>
                          <input type="text" name="adresa" class="ck-input" autocomplete="street-address" />
                          <span class="ck-error" data-error="adresa" hidden>Vyplňte adresu pro rozvoz.</span>
                        </label>
                      )}
                    </div>
                  </div>
                ))}
              </div>
              <p class="ck-error" data-error="termin" hidden>Vyberte termín.</p>
              <p class="ck-error" data-error="kapacita" hidden></p>
            </fieldset>

            <div class="ck-krok-pata">
              <div class="ck-pata-cena"><span>Celkem</span><strong class="ck-celkem">0 Kč</strong></div>
              <button type="button" class="btn btn-primary btn-large ck-dalej" data-na-krok="2">Pokračovat →</button>
            </div>

          </div>

          <!-- KROK 2: súhrn + kontakt + odoslanie -->
          <div class="ck-krok" data-krok="2" hidden>

            <div class="ck-souhrn" aria-live="polite">
              <div class="ck-souhrn-hlava">
                <span class="ck-souhrn-nadpis">Vaše objednávka</span>
                <button type="button" class="ck-spat" data-na-krok="1">Upravit</button>
              </div>
              <div class="ck-souhrn-radky" id="ck-souhrn-radky"></div>
              <div class="ck-souhrn-termin" id="ck-souhrn-termin"></div>
              <div class="ck-souhrn-celkem">
                <span>Celkem k úhradě</span>
                <strong class="ck-celkem">0 Kč</strong>
              </div>
            </div>

            <fieldset class="ck-fieldset">
              <legend class="ck-legend">Kontakt</legend>
              <label class="ck-field">
                <span class="ck-label">Jméno a příjmení</span>
                <input type="text" name="meno" class="ck-input" autocomplete="name" />
                <span class="ck-error" data-error="meno" hidden>Vyplňte jméno a příjmení.</span>
              </label>
              <label class="ck-field">
                <span class="ck-label">E-mail</span>
                <input type="email" name="email" class="ck-input" autocomplete="email" inputmode="email" />
                <span class="ck-error" data-error="email" hidden>Vyplňte platný e-mail.</span>
              </label>
              <label class="ck-field">
                <span class="ck-label">Telefon</span>
                <input type="tel" name="telefon" class="ck-input" autocomplete="tel" inputmode="tel" />
                <span class="ck-error" data-error="telefon" hidden>Vyplňte telefon.</span>
              </label>
              <label class="ck-field">
                <span class="ck-label">Poznámka (nepovinné)</span>
                <textarea name="poznamka" class="ck-input" rows="3"></textarea>
              </label>
            </fieldset>

            <div class="ck-platba-info">
              <p><strong>Platba převodem na účet.</strong> Údaje k platbě se zobrazí hned po odeslání objednávky a přijdou vám také e-mailem.</p>
              <p class="ck-upozorneni" set:html={UPOZORNENI} />
            </div>

            <label class="ck-check">
              <input type="checkbox" name="souhlas" />
              <span>Souhlasím s <a href="/obchodni-podminky#cukrovi" target="_blank">obchodními podmínkami</a> a se <a href="/ochrana-soukromi" target="_blank">zpracováním osobních údajů</a>.</span>
            </label>
            <p class="ck-error" data-error="souhlas" hidden>Pro odeslání je potřeba souhlas.</p>

            <!-- Skryté pole proti robotom: človek ho nevidí, robot ho vyplní. -->
            <div class="ck-hp" aria-hidden="true">
              <label>Web <input type="text" name="web" tabindex="-1" autocomplete="off" /></label>
            </div>

            <button type="submit" class="btn btn-primary btn-large ck-submit">Objednávka zavazující k platbě</button>
            <p class="ck-error" data-error="odeslani" hidden>Objednávku se nepodařilo odeslat. Zkuste to prosím znovu.</p>
            <button type="button" class="ck-spat ck-spat-dole" data-na-krok="1">← Zpět na množství a termín</button>

          </div>
        </form>

        <div class="ck-dekujeme" id="ck-dekujeme" hidden>
          <h3>Děkuji, objednávku jsem přijala.</h3>
          <p>Objednávka je platná až po zaplacení. Zaplaťte prosím do 3 pracovních dnů.</p>

          <div class="ck-platba">
            <dl class="ck-platba-udaje">
              <div><dt>Částka</dt><dd id="ck-dekujeme-cena"></dd></div>
              <div><dt>Číslo účtu</dt><dd>{PLATBA.cisloUctu ?? <span class="ck-placeholder">DOPLNIŤ: číslo účtu</span>}</dd></div>
              <div><dt>Variabilní symbol</dt><dd id="ck-platba-vs"></dd></div>
              <div><dt>Zpráva pro příjemce</dt><dd id="ck-platba-zprava"></dd></div>
            </dl>
            <figure class="ck-qr">
              {PLATBA.iban
                ? <div id="ck-qr"></div>
                : <div class="ck-placeholder">DOPLNIŤ: IBAN (z neho sa vytvorí QR kód)</div>}
              <figcaption>QR platba, naskenujte v aplikaci banky</figcaption>
            </figure>
          </div>

          <p class="ck-dalsi-krok">Po úspěšném zaplacení vám pošlu fakturu a potvrzení objednávky.</p>
        </div>
        <div id="ck-qr-data" data-iban={PLATBA.iban ?? ''} hidden></div>
      </div>

      <!-- JAK TO FUNGUJE -->
      <div class="ck-jak">
      <div class="eyebrow">Jak to funguje</div>
      <h2 class="ck-h2">Objednávka <em>ve 4 krocích</em></h2>
      <ol class="ck-kroky">
        <li><h3>Vyberete si cukroví</h3><p>Ve formuláři zvolíte velikost krabičky a termín. Platební údaje s QR kódem uvidíte hned po potvrzení.</p></li>
        <li><h3>Zaplatíte přes QR kód</h3><p>Do 3 pracovních dnů. Kdybyste zapomněli, připomenu se e-mailem.</p></li>
        <li><h3>Napeču to za vás</h3><p>Jakmile platba dorazí, pošlu vám potvrzení s fakturou. Od té chvíle máte cukroví jisté.</p></li>
        <li><h3>Převezmete cukroví</h3><p>Osobně na mé provozovně, nebo vám ho přivezeme po Brně.</p></li>
      </ol>
      </div>
    </section>

    <script define:vars={{ formConfig }}>
      const form = document.getElementById('ck-form');
      const kcFmt = (n) => n.toLocaleString('cs-CZ') + ' Kč';
      const adresaBox = document.getElementById('ck-adresa');

      // Voľné krabičky zo sheetu. null = nevieme alebo bez limitu.
      const kap = { terminy: {}, male: null, vyprodane: { velke: false, male: false } };
      const volneVelke = (id) => kap.terminy[id]?.zbyva ?? null;
      const maxPre = (name) => kap.vyprodane[name] ? 0 : Math.max(0, Math.min(formConfig.maxKrabic, name === 'male' && kap.male != null ? kap.male : Infinity));

      const data = () => {
        const fd = new FormData(form);
        const velke = Number(fd.get('velke') || 0);
        const male = Number(fd.get('male') || 0);
        const prevzeti = formConfig.prevzeti.find(p => p.id === fd.get('termin'));
        const rozvoz = !!prevzeti?.rozvoz;
        const celkem = velke * formConfig.cenaVelka + male * formConfig.cenaMala + (rozvoz ? formConfig.cenaRozvoz : 0);
        return { fd, velke, male, prevzeti, rozvoz, celkem };
      };

      const render = () => {
        const { velke, male, prevzeti, rozvoz, celkem } = data();
        const radky = [];
        if (velke) radky.push([`Velká krabička × ${velke}`, velke * formConfig.cenaVelka]);
        if (male) radky.push([`Malá krabička × ${male}`, male * formConfig.cenaMala]);
        if (rozvoz) radky.push(['Rozvoz po Brně', formConfig.cenaRozvoz]);
        document.getElementById('ck-souhrn-radky').innerHTML = radky
          .map(([t, c]) => `<div class="ck-souhrn-radek"><span>${t}</span><span>${kcFmt(c)}</span></div>`).join('');
        document.getElementById('ck-souhrn-termin').textContent = prevzeti ? prevzeti.text : '';
        form.querySelectorAll('.ck-celkem').forEach(el => { el.textContent = kcFmt(celkem); });
        adresaBox.hidden = !rozvoz;
      };

      const showError = (key, show, text) => {
        form.querySelectorAll(`[data-error="${key}"]`).forEach(el => {
          el.hidden = !show;
          if (text != null) el.textContent = text;
        });
      };

      // Ktoré polia sa kontrolujú v ktorom kroku.
      const POLIA = {
        1: ['krabicky', 'male', 'termin', 'kapacita', 'adresa'],
        2: ['meno', 'email', 'telefon', 'souhlas'],
      };
      // Kroky, v ktorých už zákazníčka skúsila pokračovať (tam sa chyby ukazujú priebežne).
      const skusila = new Set();

      const validate = (krok) => {
        const { fd, velke, male, prevzeti, rozvoz } = data();
        const txt = (k) => String(fd.get(k) || '').trim();
        const volne = prevzeti ? volneVelke(prevzeti.id) : null;
        const checks = {
          krabicky: velke + male > 0,
          male: kap.male == null || male <= kap.male,
          termin: !!prevzeti,
          kapacita: volne == null || velke <= volne,
          adresa: !rozvoz || txt('adresa').length > 0,
          meno: txt('meno').length > 0,
          email: /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(txt('email')),
          telefon: txt('telefon').replace(/\D/g, '').length >= 9,
          souhlas: fd.get('souhlas') === 'on',
        };
        const texty = {
          male: `Volné malé krabičky: ${kap.male}.`,
          kapacita: `Volné velké krabičky na tento termín: ${volne}. Zvolte jiný termín nebo méně krabiček.`,
        };
        POLIA[krok].forEach(k => showError(k, !checks[k], texty[k]));
        return POLIA[krok].every(k => checks[k]);
      };

      const prvaChyba = () =>
        form.querySelector('.ck-krok:not([hidden]) .ck-error:not([hidden])')?.scrollIntoView({ behavior: 'smooth', block: 'center' });

      // Prepínanie krokov 1 ↔ 2.
      const NAZVY_KROKOV = { 1: 'Množství a termín', 2: 'Kontakt a platba' };
      const ukazKrok = (krok) => {
        form.querySelectorAll('.ck-krok').forEach(el => { el.hidden = el.dataset.krok !== String(krok); });
        form.querySelectorAll('[data-postup]').forEach(el => {
          el.classList.toggle('is-aktivny', Number(el.dataset.postup) <= krok);
        });
        document.getElementById('ck-postup-cislo').textContent = String(krok);
        document.getElementById('ck-postup-nazov').textContent = NAZVY_KROKOV[krok];
        form.scrollIntoView({ behavior: 'smooth', block: 'start' });
      };
      // Krok 2 má vlastný záznam v histórii prehliadača: tlačidlo Späť v prehliadači
      // vráti na krok 1 (namiesto skoku inam na stránke). Posun stránky riadi ukazKrok.
      if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
      const naKrok2 = () => {
        skusila.add(1);
        if (!validate(1)) { prvaChyba(); return; }
        if (history.state?.ckKrok !== 2) history.pushState({ ckKrok: 2 }, '');
        ukazKrok(2);
      };
      const spatNaKrok1 = () => {
        if (history.state?.ckKrok === 2) history.back(); // popstate nižšie ukáže krok 1
        else ukazKrok(1);
      };
      window.addEventListener('popstate', (e) => {
        if (form.hidden) return; // po odoslaní objednávky už kroky neprepíname
        ukazKrok(e.state?.ckKrok === 2 && validate(1) ? 2 : 1);
      });
      form.querySelectorAll('[data-na-krok]').forEach(btn => {
        btn.addEventListener('click', () => (btn.dataset.naKrok === '2' ? naKrok2() : spatNaKrok1()));
      });

      // Prepínač Osobně / Rozvoz: ukáže termíny len zvoleného spôsobu.
      // Termín z druhej skupiny sa zruší; keď má skupina jediný voľný termín (rozvoz), vyberie sa sám.
      const ukazSkupinu = () => {
        const z = form.querySelector('input[name="zpusob"]:checked')?.value || 'osobne';
        form.querySelectorAll('[data-skupina]').forEach(el => { el.hidden = el.dataset.skupina !== z; });
        const vybrany = form.querySelector('input[name="termin"]:checked');
        if (vybrany && vybrany.closest('[data-skupina]').dataset.skupina !== z) vybrany.checked = false;
        const volne = [...form.querySelectorAll(`[data-skupina="${z}"] input[name="termin"]:not(:disabled)`)];
        if (volne.length === 1 && !form.querySelector('input[name="termin"]:checked')) volne[0].checked = true;
      };
      // Listener na prepínači beží skôr než 'change' na formulári, takže súhrn a cena sa prepočítajú až potom.
      form.querySelectorAll('input[name="zpusob"]').forEach(r => r.addEventListener('change', ukazSkupinu));

      // Tlačidlá −/+ pri počte krabičiek (0 až maxKrabic, pri malých najviac koľko ostáva).
      const syncStepper = (name) => {
        const input = form.elements[name];
        const n = Number(input.value);
        form.querySelector(`[data-value-for="${name}"]`).textContent = String(n);
        form.querySelector(`[data-for="${name}"][data-step="-1"]`).disabled = n <= 0;
        form.querySelector(`[data-for="${name}"][data-step="1"]`).disabled = n >= maxPre(name);
        form.querySelector(`[data-produkt="${name}"]`).classList.toggle('is-vybrane', n > 0);
      };
      form.querySelectorAll('.ck-step').forEach(btn => {
        btn.addEventListener('click', () => {
          const name = btn.dataset.for;
          const input = form.elements[name];
          const n = Math.min(maxPre(name), Math.max(0, Number(input.value) + Number(btn.dataset.step)));
          input.value = String(n);
          syncStepper(name);
          form.dispatchEvent(new Event('change', { bubbles: true }));
        });
      });
      ['velke', 'male'].forEach(syncStepper);

      // „Objednat" pri krabičke: vo formulári predvolí 1 kus tej krabičky.
      // Ak už zákazníčka má vybraté viac, počet nemeníme. (Eva, 26. 11. 2026)
      document.querySelectorAll('[data-predvolit]').forEach(a => {
        a.addEventListener('click', () => {
          const name = a.dataset.predvolit;
          const input = form.elements[name];
          if (!input || Number(input.value) > 0 || maxPre(name) < 1) return;
          input.value = '1';
          syncStepper(name);
          form.dispatchEvent(new Event('change', { bubbles: true }));
          spatNaKrok1();
        });
      });

      // Info ikona na fotke krabičky: klik/ťuk otvorí a zavrie tooltip, klik inde ho zavrie.
      const zavriInfo = () => document.querySelectorAll('.ck-info.is-open').forEach(i => {
        i.classList.remove('is-open');
        i.querySelector('.ck-info-btn').setAttribute('aria-expanded', 'false');
      });
      document.querySelectorAll('.ck-info-btn').forEach(b => b.addEventListener('click', (e) => {
        e.stopPropagation();
        const otvor = !b.parentElement.classList.contains('is-open');
        zavriInfo();
        if (otvor) { b.parentElement.classList.add('is-open'); b.setAttribute('aria-expanded', 'true'); }
      }));
      document.addEventListener('click', zavriInfo);
      document.addEventListener('keydown', (e) => { if (e.key === 'Escape') zavriInfo(); });

      // ---- Voľné krabičky živo zo sheetu (Eva, 27. 11. 2026) ----
      // Čeština: 1 krabička, 2-4 krabičky, 5+ krabiček (Eva, 27. 11. 2026).
      const zbyvaText = (n) => n === 1 ? 'Zbývá 1 krabička' : n >= 2 && n <= 4 ? `Zbývají ${n} krabičky` : `Zbývá ${n} krabiček`;

      const pouzijKapacitu = () => {
        form.querySelectorAll('[data-termin]').forEach(card => {
          const id = card.dataset.termin;
          const t = kap.terminy[id];
          const input = card.querySelector('input');
          if (!t || t.zbyva == null || input.disabled) return;
          const zbyvaEl = card.querySelector('.ck-zbyva');
          const bar = card.querySelector('.ck-bar');
          if (t.zbyva <= 0) {
            input.disabled = true;
            input.checked = false;
            card.classList.add('is-obsazeno');
            card.classList.remove('is-malo');
            bar.hidden = true;
            zbyvaEl.textContent = 'Vyprodáno';
            const li = document.querySelector(`[data-termin-info="${id}"]`);
            if (li) { li.classList.add('is-obsazeno'); li.querySelector('.ck-obsazeno-txt').textContent = ' (vyprodáno)'; }
            return;
          }
          bar.hidden = false;
          bar.firstElementChild.style.width = t.max ? Math.max(6, Math.min(100, Math.round(t.zbyva / t.max * 100))) + '%' : '100%';
          card.classList.toggle('is-malo', t.zbyva <= 5);
          zbyvaEl.textContent = zbyvaText(t.zbyva);
        });
        // VYPREDANÉ KRABIČKY (Eva, 28. 11. 2026)
        //  • malá = v sheete „Malé ostáva“ je 0 (počet sa inak neukazuje, limit však platí),
        //  • veľká = nedá sa vybrať žiaden termín, ani rozvoz. Rozvoz je v sheete bez limitu,
        //    takže veľká sa vypredá, až keď má aj rozvoz v stĺpci „Voľných“ 0 (alebo ručné „obsazeno“).
        //  Bez voľného termínu sa nedá objednať nič, takže vtedy je vypredaná aj malá.
        const ziadenTermin = [...form.querySelectorAll('input[name="termin"]')].every(i => i.disabled);
        kap.vyprodane = { velke: ziadenTermin, male: ziadenTermin || (kap.male != null && kap.male <= 0) };
        [['velke', 'velka'], ['male', 'mala']].forEach(([name, kartaId]) => {
          const vyprodano = kap.vyprodane[name];
          // Formulár: „Vyprodáno“ pri krabičke a stlmený riadok.
          form.querySelector(`[data-vyprodano="${name}"]`).hidden = !vyprodano;
          form.querySelector(`[data-produkt="${name}"]`).classList.toggle('is-obsazeno', vyprodano);
          // Hlavná karta: štítok na fotke, tlačidlo „Vyprodáno“ bez akcie, poznámka o uzávierke sa skryje.
          const karta = document.querySelector(`.ck-box-${kartaId}`);
          if (karta) {
            karta.classList.toggle('is-vyprodano', vyprodano);
            karta.querySelector('.ck-box-stitok').hidden = !vyprodano;
            const btn = karta.querySelector('.btn');
            btn.textContent = vyprodano ? 'Vyprodáno' : 'Objednat';
            if (vyprodano) { btn.setAttribute('aria-disabled', 'true'); btn.removeAttribute('href'); }
            else { btn.removeAttribute('aria-disabled'); btn.setAttribute('href', '#objednavka'); }
          }
          const input = form.elements[name];
          if (Number(input.value) > maxPre(name)) input.value = String(maxPre(name));
        });
        ['velke', 'male'].forEach(syncStepper);
        form.dispatchEvent(new Event('change', { bubbles: true }));
      };

      // Jednoduchý CSV parser (úvodzovky, čiarky v texte).
      const parseCsv = (txt) => {
        const rows = []; let row = [], cell = '', q = false;
        for (let i = 0; i < txt.length; i++) {
          const c = txt[i];
          if (q) { if (c === '"') { if (txt[i + 1] === '"') { cell += '"'; i++; } else q = false; } else cell += c; }
          else if (c === '"') q = true;
          else if (c === ',') { row.push(cell); cell = ''; }
          else if (c === '\n') { row.push(cell); rows.push(row); row = []; cell = ''; }
          else if (c !== '\r') cell += c;
        }
        if (cell || row.length) { row.push(cell); rows.push(row); }
        return rows;
      };
      const cislo = (v) => { const s = String(v ?? '').replace(/\s/g, '').replace(',', '.'); return s !== '' && !isNaN(Number(s)) ? Number(s) : null; };
      const norm = (v) => String(v ?? '').toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '').replace(/\s/g, '');

      window.ckNacitajKapacitu = (csv) => {
        const rows = parseCsv(csv);
        // Stĺpce hľadáme podľa nadpisov, aby nevadilo, keď Eva stĺpce posunie.
        const hi = rows.findIndex(r => r.some(c => norm(c).startsWith('volnych')));
        const head = hi >= 0 ? rows[hi].map(norm) : [];
        const col = (zaciatok, inak) => { const i = head.findIndex(h => h.startsWith(zaciatok)); return i >= 0 ? i : inak; };
        const cVolne = col('volnych', 3), cMax = col('maximalna', 2), cMale = col('maleostava', 7);
        const telo = rows.slice(hi + 1);
        formConfig.prevzeti.forEach(p => {
          const r = telo.find(r => norm(r[0]).startsWith(p.sheet));
          if (r) kap.terminy[p.id] = { zbyva: cislo(r[cVolne]), max: cislo(r[cMax]) };
        });
        const maleRiadok = telo.find(r => cislo(r[cMale]) != null);
        kap.male = maleRiadok ? cislo(maleRiadok[cMale]) : null;
        pouzijKapacitu();
      };
      if (formConfig.kapacitaSheet) {
        fetch(formConfig.kapacitaSheet)
          .then(r => r.ok ? r.text() : Promise.reject(r.status))
          .then(window.ckNacitajKapacitu)
          .catch(() => { /* sheet sa nenačítal: formulár funguje ďalej bez ukazovateľa */ });
      }

      // Ochrana proti robotom: skryté pole musí ostať prázdne
      // a od načítania stránky musia uplynúť aspoň 3 sekundy.
      const nacitane = Date.now();
      const jeRobot = () => String(new FormData(form).get('web') || '') !== '' || Date.now() - nacitane < 3000;

      // Variabilný symbol = telefón bez predvoľby (posledných 9 číslic).
      const vsZTelefonu = (tel) => String(tel || '').replace(/\D/g, '').slice(-9);
      // Zpráva pro příjemce: „Cukrovi 2026“ + meno zákazníčky, bez diakritiky, veľkými písmenami, max. 60 znakov (štandard QR Platba).
      const zpravaPre = (meno) => `${formConfig.zprava} ${meno}`
        .normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/[^A-Za-z0-9 .,-]/g, '')
        .toUpperCase().slice(0, 60);

      const zobrazDekujeme = (celkem, meno, telefon) => {
        form.hidden = true;
        const vs = vsZTelefonu(telefon);
        const zprava = zpravaPre(meno || '');
        document.getElementById('ck-dekujeme-cena').textContent = kcFmt(celkem);
        document.getElementById('ck-platba-vs').textContent = vs;
        document.getElementById('ck-platba-zprava').textContent = zprava;
        // QR kód vykreslí skript nižšie (window.ckQrPlatba), ak je vyplnený IBAN.
        window.ckQrPlatba?.({ castka: celkem, vs, zprava });
        const dk = document.getElementById('ck-dekujeme');
        dk.hidden = false;
        dk.scrollIntoView({ behavior: 'smooth', block: 'start' });
      };

      // Po prvom pokuse o pokračovanie/odoslanie sa chyby v danom kroku aktualizujú priebežne.
      const update = () => { render(); skusila.forEach(k => validate(k)); };
      form.addEventListener('change', update);
      form.addEventListener('input', update);
      render();

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        showError('odeslani', false);
        // Enter v kroku 1 = „Pokračovat“, nie odoslanie.
        if (form.querySelector('[data-krok="2"]').hidden) {
          form.querySelector('.ck-dalej').click();
          return;
        }
        skusila.add(1);
        skusila.add(2);
        if (!validate(1)) { spatNaKrok1(); setTimeout(prvaChyba, 400); return; }
        if (!validate(2)) { prvaChyba(); return; }
        const { fd, velke, male, prevzeti, rozvoz, celkem } = data();
        // Robotovi sa tvárime, že prešiel, ale nič neodošleme.
        if (jeRobot()) { zobrazDekujeme(celkem, fd.get('meno'), fd.get('telefon')); return; }
        const e2 = formConfig.entry;
        const body = new URLSearchParams();
        body.append(e2.meno, String(fd.get('meno')).trim());
        body.append(e2.email, String(fd.get('email')).trim());
        body.append(e2.telefon, String(fd.get('telefon')).trim());
        body.append(e2.velke, String(velke));
        body.append(e2.male, String(male));
        body.append(e2.prevzeti, prevzeti.text);
        body.append(e2.adresa, rozvoz ? String(fd.get('adresa')).trim() : '');
        body.append(e2.poznamka, String(fd.get('poznamka') || '').trim());
        body.append(e2.cena, String(celkem));
        body.append(e2.souhlas, 'Ano');

        const btn = form.querySelector('.ck-submit');
        btn.disabled = true;
        btn.textContent = 'Odesílám…';
        try {
          // Google Formulár neposiela späť odpoveď (no-cors); úspech = request odišiel.
          await fetch(formConfig.action, { method: 'POST', mode: 'no-cors', body });
          zobrazDekujeme(celkem, String(fd.get('meno')).trim(), fd.get('telefon'));
        } catch (err) {
          showError('odeslani', true);
          btn.disabled = false;
          btn.textContent = 'Objednávka zavazující k platbě';
        }
      });
    </script>

    <script>
      // QR Platba (český štandard SPD). Generuje sa priamo v prehliadači,
      // údaje nikam neodchádzajú.
      import qrcode from 'qrcode-generator';

      const iban = (document.getElementById('ck-qr-data')?.dataset.iban || '').replace(/\s/g, '');

      (window as any).ckQrPlatba = ({ castka, vs, zprava }: { castka: number; vs: string; zprava: string }) => {
        const box = document.getElementById('ck-qr');
        if (!iban || !box) return;
        const spd = [
          'SPD*1.0',
          `ACC:${iban}`,
          `AM:${castka.toFixed(2)}`,
          'CC:CZK',
          vs ? `X-VS:${vs}` : '',
          zprava ? `MSG:${zprava}` : '',
        ].filter(Boolean).join('*');
        const qr = qrcode(0, 'M');
        qr.addData(spd);
        qr.make();
        box.innerHTML = qr.createSvgTag({ cellSize: 6, margin: 2, scalable: true });
      };
    </script>

  </main>

</BaseLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import RecipeCard from '../components/RecipeCard.astro';
import { Image } from 'astro:assets';
import { FEATURED, RECIPES } from '../data/recipes.js';
import { SEZONA_CUKROVI } from '../data/cukrovi.js';
import ebookZdarmaImg from '../assets/images/ebook-jedno-cesto-3-kolace.jpeg';
import ebookPlatenyImg from '../assets/images/ebook-plateny/obalka-landing.jpg';
import cukroviHeroImg from '../assets/images/cukrovi/velka-detail4.jpeg';

const featuredRecipes = RECIPES.filter(r => r.featured);
const popularRecipes = RECIPES.filter(r => r.popular);

const imageModules = import.meta.glob('/src/assets/images/*.{jpg,jpeg,png,webp}', { eager: true });
const heroImgKey = FEATURED.image ? `/src/assets/images/${FEATURED.image.split('/').pop()}` : null;
const heroImgModule = heroImgKey ? imageModules[heroImgKey] : null;

---

<BaseLayout
  title="Evka pečie — Tradičné recepty SK/CZ"
  description="Tradičné recepty zo slovenskej a českej kuchyne, presne tak ako ich poznáme z domu."
  activeNav="home"
>

  <!-- HERO: CUKROVÍ (len v sezóne, prepína sa v data/cukrovi.js) -->
  {SEZONA_CUKROVI && (
  <section class="container hero">
    <div class="hero-inner">
      <div class="hero-text">
        <div class="hero-text-top">
          <div class="eyebrow">Vánoční nabídka</div>
          <h1 class="hero-title" style="margin-top:22px">Cukroví</h1>
        </div>
        <div class="hero-text-bottom">
          <p class="hero-sub">
            Letos jsem pro vás připravila krabičku toho nejlepšího vánočního cukroví, jaké znám. Najdete v ní 8 druhů, od tradiční klasiky jako linecké a vanilkové rohlíčky až po modernější kousky, třeba malinové tartaletky s bílou čokoládou. Cukroví peču ručně z kvalitních surovin a letos ho moc ráda upeču i za vás. Krabičku si pak můžete vyzvednout osobně v Brně.
          </p>
          <div class="hero-cta">
            <a href="/cukrovi" class="btn btn-primary btn-large">Chci vánoční cukroví</a>
          </div>
        </div>
      </div>

      <a href="/cukrovi" class="hero-image">
        <Image
          src={cukroviHeroImg}
          alt="Vánoční cukroví ve velké krabičce"
          width={800}
          style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover"
          loading="eager"
          fetchpriority="high"
        />
      </a>
    </div>
  </section>
  )}

  <!-- HERO: NOVÝ RECEPT (mimo sezóny cukroví) -->
  {!SEZONA_CUKROVI && (
  <section class="container hero">
    <div class="hero-inner">
      <div class="hero-text">
        <div class="hero-text-top">
          <div class="eyebrow">Nový recept</div>
          <h1 class="hero-title" style="margin-top:22px" set:html={FEATURED.title} />
        </div>
        <div class="hero-text-bottom">
          <p class="hero-sub">{FEATURED.intro}</p>
          <div class="hero-cta">
            <a href={`/recept/${FEATURED.slug}`} class="btn btn-primary btn-large">
              Zobraziť recept <span class="arrow">→</span>
            </a>
          </div>
        </div>
      </div>

      <a href={`/recept/${FEATURED.slug}`}
         class={`hero-image${!FEATURED.image ? ' paint-' + FEATURED.paint : ''}`}>
        {heroImgModule && (
          <Image
            src={heroImgModule.default}
            alt={FEATURED.title.replace(/<[^>]+>/g, '')}
            width={800}
            height={1000}
            style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover"
            loading="eager"
            fetchpriority="high"
          />
        )}
        <div class="badge">
          <b>{FEATURED.time}</b> · {FEATURED.servings} · {FEATURED.level}
        </div>
      </a>
    </div>
  </section>
  )}

  <!-- NEJNOVĚJŠÍ RECEPTY -->
  <section class="container section">
    <div class="section-head">
      <div>
        <div class="eyebrow">Aktuálne</div>
        <h2 class="section-title"><em>Najnovšie</em> recepty</h2>
      </div>
      <a class="section-more" href="/recepty">Všetky recepty <span class="arrow">→</span></a>
    </div>
    <div class="recipe-grid">
      {featuredRecipes.map(r => <RecipeCard recipe={r} />)}
    </div>
  </section>

  <!-- E-BOOKY -->
  <section class="container section" style="padding-top:16px">
    <div class="section-head">
      <div>
        <div class="eyebrow">E-booky</div>
        <h2 class="section-title"><em>Jedno cesto</em>, veľa koláčov</h2>
      </div>
    </div>
    <div class="eb-grid">
      <a class="eb-card" href="/ebook-zdarma">
        <Image src={ebookZdarmaImg} alt="Obálka e-booku Jedno cesto, 3 koláče" width={320} class="eb-card-img" />
        <div>
          <div class="eb-card-label">Zdarma</div>
          <h3 class="eb-card-title">Jedno cesto, 3 koláče</h3>
          <p class="eb-card-text">Jedno kysnuté cesto a tri úplne iné koláče. Postup krok za krokom.</p>
          <span class="eb-card-more">Stiahnuť zdarma <span class="arrow">→</span></span>
        </div>
      </a>
      <a class="eb-card" href="/jedno-cesto-10-kolacov">
        <Image src={ebookPlatenyImg} alt="Obálka e-booku Jedno cesto, 10 koláčov" width={320} class="eb-card-img" />
        <div>
          <div class="eb-card-label">299 Kč</div>
          <h3 class="eb-card-title">Jedno cesto, 10 koláčov</h3>
          <p class="eb-card-text">Systém, ako z jedného kysnutého cesta vytvárať vlastné sladké aj slané koláče. 10 otestovaných receptov.</p>
          <span class="eb-card-more">Pozrieť e-book <span class="arrow">→</span></span>
        </div>
      </a>
    </div>
  </section>

  <!-- NEJOBLÍBENĚJŠÍ RECEPTY -->
  <section class="container section" style="padding-top:16px">
    <div class="section-head">
      <div>
        <div class="eyebrow">Z archívu</div>
        <h2 class="section-title"><em>Najobľúbenejšie</em> recepty</h2>
      </div>
      <a class="section-more" href="/recepty">Všetky recepty <span class="arrow">→</span></a>
    </div>
    <div class="recipe-grid">
      {popularRecipes.map(r => <RecipeCard recipe={r} />)}
    </div>
  </section>

</BaseLayout>

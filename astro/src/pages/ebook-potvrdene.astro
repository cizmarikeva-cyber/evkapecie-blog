---
import BaseLayout from '../layouts/BaseLayout.astro';

const EBOOK_PDF = '/ebook/jedno-cesto-3-kolace.pdf';
---

<BaseLayout
  title="Hotovo, potvrdené | Evka pečie"
  description="Ďakujem za potvrdenie. Tu si stiahneš e-book Jedno cesto, 3 koláče."
>
  <main class="confirm">
    <h1 class="confirm-title">Hotovo, potvrdené.</h1>

    <p class="confirm-lead">Tu je tvoj e-book. Môžeš začať piecť!</p>

    <a class="btn btn-primary btn-large confirm-cta" href={EBOOK_PDF} download>
      Stiahnuť e-book
    </a>
    <p class="confirm-filemeta">PDF, 21 MB</p>

    <p class="confirm-note">
      Poslala som ti ho aj e-mailom, takže ho máš odložený aj tam. Keby ti e-mail nechodil,
      pozri sa medzi reklamy alebo do spamu. Najistejšie je pridať si
      <a href="mailto:eva@evkapecie.cz">eva@evkapecie.cz</a> medzi kontakty, potom ti už nič neujde.
    </p>
  </main>

  <style>
    .confirm {
      max-width: 620px;
      margin: 0 auto;
      padding: 96px 32px 120px;
      text-align: center;
    }
    .confirm-title {
      font-family: var(--font-display);
      color: var(--ink);
      font-size: clamp(2.25rem, 5vw, 3rem);
      line-height: 1.1;
      margin: 0 0 24px;
    }
    .confirm-lead {
      font-family: var(--font-body);
      font-size: 20px;
      line-height: 1.55;
      color: var(--ink);
      margin: 0 0 32px;
    }
    .confirm-cta {
      text-decoration: none;
    }
    .confirm-filemeta {
      font-family: var(--font-body);
      font-size: 14px;
      color: var(--ink-mute);
      margin: 12px 0 40px;
    }
    .confirm-note {
      font-family: var(--font-body);
      font-size: 17px;
      line-height: 1.65;
      color: var(--ink-soft);
      margin: 0;
    }
    .confirm-note a {
      color: var(--maroon);
      text-decoration: underline;
      text-underline-offset: 3px;
    }
    @media (max-width: 768px) {
      .confirm {
        padding: 56px 20px 72px;
      }
    }
  </style>
</BaseLayout>

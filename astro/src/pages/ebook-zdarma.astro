---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import ebookImg from '../assets/images/ebook-jedno-cesto-3-kolace.jpeg';

// Adresa z atributu action formuláře v Brevo (Formuláře → tvůj formulář → Sdílet → HTML kód).
const BREVO_FORM_ACTION = 'https://1acb54ba.sibforms.com/serve/MUIFAINQ2H7ikGuWmxx3MJUkkQIcx2Ylj523b5q80QjOFLMUGduI0jvQYsZmCeKwD4321vFqTVmI4ECJNiG2w-wbqSFQ3KrV9RIUHXqvFLBjeuKbhl7NlHBRRtQSVQi6Hzu9BNfHmHORx6uHUSzH8BvmghT581AqWsOXVuzWNnDayUNKSxJaN4_lIeBUS2Mwh0C6imoOZAik2Ix0Qw==';
---

<BaseLayout
  title="Jedno cesto, 3 koláče — e-book zdarma | Evka pečie"
  description="Stáhni si zdarma e-book s jedním základním kynutým těstem, ze kterého upečeš tři různé koláče. Postup krok za krokem a rady, co dělat, když se něco nedaří."
>

  <main class="ebook-main">

    <!-- HERO -->
    <section class="container ebook-hero">
      <div class="ebook-hero-inner">

        <div class="ebook-hero-text">
          <div class="eyebrow ebook-eyebrow">E-book zdarma</div>
          <h1 class="ebook-title">Jedno cesto, <em>3 koláče</em></h1>
          <p class="ebook-lead">
            Na kysnutom ceste ma baví jeho všestrannosť. Z jedného základného cesta sa dajú upiecť koláče, buchty aj slané pečivo.
          </p>
          <p class="ebook-lead">
            Za tie roky, čo pečiem, som sa naučila jednu vec: na dobré domáce pečenie netreba desiatky receptov. Stačí mať jeden spoľahlivý recept na cesto, ktorý funguje, a z neho sa dá tvoriť nespočetné množstvo dobrôt rôznych tvarov a chutí.
          </p>
          <p class="ebook-lead">
            V tomto e-booku ti dám presný recept na moje overené kysnuté cesto, s postupom krok za krokom, a ukážem ti, ako sa z neho dajú upiecť tri úplne iné koláče.
          </p>
        </div>

        <div class="ebook-hero-media">
          <Image
            src={ebookImg}
            alt="Obálka e-booku Jedno cesto, 3 koláče"
            class="ebook-hero-img"
            width={720}
            height={1019}
          />
        </div>

      </div>
    </section>

    <!-- FORMULÁŘ -->
    <section class="container ebook-form-section" id="formular">
      <div class="newsletter">
        <div class="newsletter-inner">

          <div>
            <h2>Email, na ktorý ti ho pošlem:</h2>
          </div>

          <div class="brevo-form-wrap">
            <div id="sib-form-container" class="sib-form-container">
              <div id="error-message" class="sib-form-message-panel" style="color:#661d1d;background-color:#ffeded;border-color:#ff4949;border-radius:8px;margin-bottom:16px;display:none">
                <div class="sib-form-message-panel__text"><span class="sib-form-message-panel__inner-text">Niečo sa pokazilo. Skúste to prosím znovu.</span></div>
              </div>
              <div id="success-message" class="sib-form-message-panel" style="color:#085229;background-color:#e7faf0;border-color:#13ce66;border-radius:8px;margin-bottom:16px;display:none">
                <div class="sib-form-message-panel__text"><span class="sib-form-message-panel__inner-text">Skoro hotovo. Poslala som ti potvrdzovací e-mail, klikni v ňom na odkaz a e-book dorazí hneď potom. Keby nič nechodilo, skontroluj prosím aj spam.</span></div>
              </div>
              <div id="sib-container" class="sib-container--large sib-container--vertical" style="text-align:left;background-color:transparent;border:none;direction:ltr">
                <form id="sib-form" method="POST" action={BREVO_FORM_ACTION} data-type="subscription">
                  <div style="padding:8px 0">
                    <div class="sib-input sib-form-block">
                      <div class="form__entry entry_block">
                        <div class="form__label-row">
                          <label class="entry__label" for="EMAIL" data-required="*">E-mail</label>
                          <div class="entry__field"><input class="input" type="text" id="EMAIL" name="EMAIL" autocomplete="email" value="" data-required="true" required /></div>
                        </div>
                        <label id="email-error" style="display:none;color:#ffb4b4;font-family:var(--font-body);font-size:13px;margin-top:6px">Zadajte prosím e-mailovú adresu.</label>
                      </div>
                    </div>
                  </div>
                  <div style="padding:8px 0">
                    <div class="sib-input sib-form-block">
                      <div class="form__entry entry_block">
                        <div class="form__label-row">
                          <label class="entry__label" for="FIRSTNAME">Meno</label>
                          <div class="entry__field"><input class="input" maxlength="200" type="text" id="FIRSTNAME" name="FIRSTNAME" autocomplete="given-name" /></div>
                        </div>
                        <label class="entry__error entry__error--primary"></label>
                      </div>
                    </div>
                  </div>
                  <div style="padding:8px 0">
                    <div class="sib-optin sib-form-block">
                      <div class="form__entry entry_mcq">
                        <div class="form__label-row">
                          <div class="entry__choice">
                            <label>
                              <input type="checkbox" class="input_replaced" value="1" id="OPT_IN" name="OPT_IN" />
                              <span class="checkbox checkbox_tick_positive"></span>
                              <span>Súhlasím so zasielaním e-mailov a spracovaním osobných údajov podľa <a href="/ochrana-soukromi">zásad ochrany osobných údajov</a>.</span>
                            </label>
                          </div>
                        </div>
                        <label id="gdpr-error" style="display:none;color:#ffb4b4;font-family:var(--font-body);font-size:13px;margin-top:6px">Prosím, potvrďte súhlas so spracovaním osobných údajov.</label>
                      </div>
                    </div>
                  </div>
                  <div style="padding:8px 0;max-width:484px;margin:0 auto;display:flex;flex-direction:column;align-items:center">
                    <div class="g-recaptcha" data-sitekey="6Lcl6WctAAAAAOnBjRGmpls-v4NVphgXsEjDIKJM" data-theme="dark"></div>
                    <label id="captcha-error" style="display:none;color:#ffb4b4;font-family:var(--font-body);font-size:13px;margin-top:6px;text-align:center">Potvrďte prosím, že nie ste robot.</label>
                  </div>
                  <div style="padding:8px 0;text-align:center">
                    <button class="sib-form-block__button sib-form-block__button-with-loader" form="sib-form" type="submit">
                      Pošli mi e-book
                    </button>
                  </div>
                  <input type="text" name="email_address_check" value="" class="input--hidden" />
                  <input type="hidden" name="locale" value="cs" />
                </form>
              </div>
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- ČO NÁJDEŠ V E-BOOKU -->
    <section class="container ebook-content">
      <h2 class="ebook-h2">Čo nájdeš v e-booku</h2>
      <ul class="ebook-list">
        <li>
          <strong>Recept na základné kysnuté cesto</strong>, presné gramáže, časy a tipy na čo si dávať pozor.
        </li>
        <li>
          <strong>Recepty na tri koláče z tohto cesta:</strong>
          <ul class="ebook-sublist">
            <li>Čučoriedkové rolky</li>
            <li>Tvarohové koláče s višňami a drobenkou</li>
            <li>Kakaová babka s orechmi</li>
          </ul>
        </li>
        <li>
          <strong>Čo sa môže pokaziť a čo s tým.</strong>
        </li>
        <li>
          <strong>Tipy, ako si uľahčiť prácu</strong>, na ktoré som prišla postupne počas rokov pečenia.
        </li>
      </ul>
    </section>

  </main>

  <script>
    // Brevo form init
    window.REQUIRED_CODE_ERROR_MESSAGE = 'Please choose a country code';
    window.LOCALE = 'cs';
    window.EMAIL_INVALID_MESSAGE = 'Zadaná adresa je v nesprávném formátu. Zkontrolujte ji prosím.';
    window.REQUIRED_ERROR_MESSAGE = 'Povinné pole.';
    window.GENERIC_INVALID_MESSAGE = 'Zadané informace jsou v nesprávném formátu. Zkontrolujte je prosím.';
    window.INVALID_NUMBER = 'Zadané informace jsou v nesprávném formátu.';
    window.INVALID_DATE = 'Zadejte prosím platné datum.';
    window.REQUIRED_MULTISELECT_MESSAGE = 'Vyberte prosím alespoň jednu možnost.';
    window.AUTOHIDE = Boolean(0);

    // Load Brevo script
    const s = document.createElement('script');
    s.src = 'https://sibforms.com/forms/end-form/build/main.js';
    document.body.appendChild(s);

    // Load Google reCAPTCHA
    const rc = document.createElement('script');
    rc.src = 'https://www.google.com/recaptcha/api.js?hl=sk';
    rc.async = true;
    rc.defer = true;
    document.body.appendChild(rc);

    // Intercept form submit
    document.addEventListener('submit', function(e) {
      const form = document.getElementById('sib-form');
      if (!form || !form.contains(e.target) && e.target !== form) return;

      e.preventDefault();
      e.stopImmediatePropagation();

      const emailEl  = document.getElementById('EMAIL');
      const checkbox = document.getElementById('OPT_IN');
      const emailErr = document.getElementById('email-error');
      const gdprErr  = document.getElementById('gdpr-error');

      let valid = true;

      if (!emailEl || !emailEl.value.trim()) {
        if (emailErr) emailErr.style.display = 'block';
        valid = false;
      } else {
        if (emailErr) emailErr.style.display = 'none';
      }

      if (!checkbox || !checkbox.checked) {
        if (gdprErr) gdprErr.style.display = 'block';
        valid = false;
      } else {
        if (gdprErr) gdprErr.style.display = 'none';
      }

      const captchaErr = document.getElementById('captcha-error');
      if (typeof grecaptcha !== 'undefined' && grecaptcha.getResponse() === '') {
        if (captchaErr) captchaErr.style.display = 'block';
        valid = false;
      } else {
        if (captchaErr) captchaErr.style.display = 'none';
      }

      if (!valid) return;

      const successEl = document.getElementById('success-message');
      const errorEl = document.getElementById('error-message');
      if (successEl) successEl.style.display = 'none';
      if (errorEl) errorEl.style.display = 'none';

      const data = new FormData(form);
      fetch(form.action, { method: 'POST', body: data, mode: 'no-cors' })
        .then(() => {
          if (successEl) successEl.style.display = 'block';
          form.reset();
        })
        .catch(() => {
          if (errorEl) errorEl.style.display = 'block';
        });
    }, true);
  </script>

</BaseLayout>
